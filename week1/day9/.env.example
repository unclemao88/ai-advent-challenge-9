DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
PORT=3000

# Optional overrides
# HOST=127.0.0.1
# DEEPSEEK_API_URL=https://api.deepseek.com
# Model used to write the memory summary. Defaults to DEEPSEEK_MODEL.
# DEEPSEEK_SUMMARY_MODEL=deepseek-chat
# Hard limit on one DeepSeek call (answer or summary).
# DEEPSEEK_TIMEOUT_MS=60000
# Where history.json and summary.json live. Defaults to ./data.
# DATA_DIR=./data
# MAX_QUESTION_CHARS=8000
