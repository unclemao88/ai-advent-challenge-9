DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
PORT=3000

# Optional overrides
# HOST=127.0.0.1
# DEEPSEEK_API_URL=https://api.deepseek.com
# Model used to extract sticky facts. Defaults to DEEPSEEK_MODEL.
# DEEPSEEK_FACTS_MODEL=deepseek-chat
# Hard limit on one DeepSeek call (answer or fact extraction).
# DEEPSEEK_TIMEOUT_MS=60000
# Context window budget. The agent trims the oldest history messages so that
# the estimated prompt stays under CONTEXT_LIMIT_TOKENS - MAX_OUTPUT_TOKENS.
# CONTEXT_LIMIT_TOKENS=64000
# MAX_OUTPUT_TOKENS=4096
# Where state.json lives. Defaults to ./data.
# DATA_DIR=./data
# MAX_QUESTION_CHARS=8000
