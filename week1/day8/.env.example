DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PORT=3000

# Tokens of conversation replayed as context per request. The model allows far
# more; this caps cost and latency, since every question resends the prompt.
# Oldest messages stop being sent once the budget is full — nothing is deleted.
# Set to 0 to send the whole conversation regardless.
DEEPSEEK_MAX_CONTEXT_TOKENS=20000

# Optional overrides
# HOST=127.0.0.1
# DEEPSEEK_TIMEOUT_MS=60000
# How many past messages to replay as context. 0 (the default) means "all".
# DEEPSEEK_HISTORY_LIMIT=0
