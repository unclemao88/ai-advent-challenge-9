# DeepSeek Agent (day 13) — configuration
#
# Copy to .env (same directory) and fill in DEEPSEEK_API_KEY.
# Variables already set in the environment (systemd Environment= lines,
# /etc/deepseek-app.env) take precedence over this file.
# Never commit .env.

# --- Server -------------------------------------------------------------------
PORT=3013
# 0.0.0.0 listens on every interface. Use 127.0.0.1 behind a reverse proxy.
HOST=0.0.0.0
NODE_ENV=production

# --- DeepSeek API ---------------------------------------------------------------
# Required. Read by the server only; never sent to the browser or logged.
DEEPSEEK_API_KEY=
# deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT_MS=60000
# DEEPSEEK_MAX_TOKENS=
# DEEPSEEK_TEMPERATURE=

# --- Storage and logs -----------------------------------------------------------
# Relative paths are resolved against the application directory.
DATA_DIR=/opt/deepseek-app-day13/data
# Set LOG_DIR=off to log to stdout/journal only.
LOG_DIR=/opt/deepseek-app-day13/logs
# debug | info | warn | error
LOG_LEVEL=info
# DeepSeek tokenizer files for exact token counts (npm run fetch:tokenizer)
# TOKENIZER_DIR=vendor/deepseek-tokenizer

# --- Agent ------------------------------------------------------------------------
# Mode for new tasks until changed in the UI: manual | auto
DEFAULT_MODE=manual
# Most states one auto-mode run may execute before it stops for the user
MAX_AUTO_STEPS=8
# Failed validations before auto mode stops and waits for the user
MAX_VALIDATION_RETRIES=2
# Messages kept in short-term memory (initial value; changeable in the UI)
SHORT_TERM_MAX_MESSAGES=40
# Token budget for long-term memory inside one request
LONG_TERM_CONTEXT_TOKENS=4000
# Upper bound for a whole request; the oldest chat turns are dropped beyond it
MAX_CONTEXT_TOKENS=100000

# --- Security -------------------------------------------------------------------
# Optional shared secret. When set, the browser asks for it once and every
# /api call must send "Authorization: Bearer <token>".
# APP_AUTH_TOKEN=
# Requests per minute per client for endpoints that call DeepSeek
RATE_LIMIT_PER_MINUTE=30
# Set to true when running behind a reverse proxy (for correct client IPs)
TRUST_PROXY=false
# How long (ms) shutdown waits for running agent steps before forcing an exit
SHUTDOWN_TIMEOUT_MS=90000
