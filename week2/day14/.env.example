# DeepSeek Agent (day 14) — configuration
#
# Production (systemd): configuration lives in /etc/deepseek-app.env, shared by
# all deepseek-app-dayNN services. scripts/install-service.sh creates it with the
# DeepSeek settings below. Do not put PORT, HOST or DATA_DIR there: the unit sets
# them, and values from that file would override them for every service.
#
# Local development: copy to .env in the project directory and set DEEPSEEK_API_KEY:
#   cp .env.example .env && chmod 600 .env
# Variables already set in the environment take precedence. Never commit .env.

# --- DeepSeek API ----------------------------------------------------------------
# Required. Read by the server only; never sent to the browser, never logged.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_MS=60000
# DEEPSEEK_MAX_TOKENS=
# DEEPSEEK_TEMPERATURE=

# --- Server ----------------------------------------------------------------------
# 0.0.0.0 listens on every interface; use 127.0.0.1 behind a reverse proxy.
HOST=0.0.0.0
PORT=3014
NODE_ENV=production

# --- Storage and logs ------------------------------------------------------------
# Relative paths are resolved against the application directory.
# DATA_DIR=data
# Logs go to stdout (the systemd journal). Set LOG_DIR to also write rotated app.log files.
# LOG_DIR=
# debug | info | warn | error
LOG_LEVEL=info
# DeepSeek tokenizer files for exact token counts (npm run fetch:tokenizer)
# TOKENIZER_DIR=vendor/deepseek-tokenizer

# --- Memory ------------------------------------------------------------------------
# Initial storage provider per layer: json | memory. Changeable later in the UI
# (Memory → Storage); the choice is kept in data/storage-config.json.
STORAGE_SHORT_TERM=json
STORAGE_WORK=json
STORAGE_LONG_TERM=json
# Messages kept in short-term memory (initial value; changeable in the UI)
SHORT_TERM_MAX_MESSAGES=30
# Token budget for relevant long-term memory inside one request
LONG_TERM_CONTEXT_TOKENS=2000
# Upper bound for a whole request; the oldest chat turns are dropped beyond it
MAX_CONTEXT_TOKENS=100000

# --- Agent -------------------------------------------------------------------------
# Mode for new tasks until changed in the UI: manual | auto
DEFAULT_MODE=manual
# Most states one auto-mode run may execute before it stops
MAX_AUTO_STEPS=8
# Failed validations before the task waits for the user
MAX_VALIDATION_RETRIES=2
# Automatic revisions of a result the invariant check rejected
MAX_INVARIANT_REVISIONS=1

# --- Security ----------------------------------------------------------------------
# Optional shared secret. When set, the browser asks for it once and every
# /api call must send "Authorization: Bearer <token>".
# APP_AUTH_TOKEN=
# Requests per minute per client for endpoints that call DeepSeek
RATE_LIMIT_PER_MINUTE=30
# Set to true behind a reverse proxy (for correct client IPs)
TRUST_PROXY=false
# How long (ms) shutdown waits for running agent steps before forcing an exit
SHUTDOWN_TIMEOUT_MS=90000
