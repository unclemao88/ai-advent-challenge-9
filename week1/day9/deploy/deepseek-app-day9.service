# systemd unit for the day 9 DeepSeek agent — Debian 12 (bookworm) / 13 (trixie).
#
#   Code:        /opt/deepseek-app-day9            (read-only for the service)
#   Memory:      /var/lib/deepseek-app-day9        (history.json, summary.json)
#   Secrets:     /etc/deepseek-app.env             (root:deepseek-app, 0640)
#   Account:     deepseek-app:deepseek-app         (deploy/deepseek-app.sysusers.conf)
#   Listens on:  127.0.0.1:3008                    (put nginx in front: deploy/nginx.conf)
#
# Install steps: README.md → "Running on Debian with systemd".

[Unit]
Description=DeepSeek agent (day 9) — chat with summary + last-10-messages memory
Documentation=https://api-docs.deepseek.com/
# network-online, not just network: every answer needs outbound DNS + TLS.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=deepseek-app
Group=deepseek-app

WorkingDirectory=/opt/deepseek-app-day9
# Check with `command -v node` — Debian's nodejs package and NodeSource both use /usr/bin/node.
ExecStart=/usr/bin/node /opt/deepseek-app-day9/src/server/server.js

Environment=NODE_ENV=production
Environment=PORT=3008
# Local only: there is no authentication. To expose the port directly instead of
# via nginx, set HOST=0.0.0.0 in /etc/deepseek-app.env.
Environment=HOST=127.0.0.1

# The conversation is the agent's memory, so it must outlive redeploys of /opt.
# systemd creates /var/lib/deepseek-app-day9 owned by the service account (0700)
# and keeps it writable under ProtectSystem=strict.
StateDirectory=deepseek-app-day9
StateDirectoryMode=0700
Environment=DATA_DIR=/var/lib/deepseek-app-day9

# libuv uses io_uring for file I/O on recent kernels, and @system-service below
# excludes those syscalls. This app writes files on every turn, so turn it off.
Environment=UV_USE_IO_URING=0

# DEEPSEEK_API_KEY=... (and optionally DEEPSEEK_MODEL, DEEPSEEK_TIMEOUT_MS, HOST).
# Kept out of this unit so the key never shows in `systemctl cat`.
# NOTE: variables from this file override the Environment= lines above — do not
# put PORT or DATA_DIR in it unless you mean to change them.
EnvironmentFile=/etc/deepseek-app.env

Restart=on-failure
RestartSec=5
# The server stops accepting connections on SIGTERM and lets open requests
# finish (it gives up after 15s). Files are written atomically either way.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepseek-app-day9

# --- Hardening --------------------------------------------------------------
# Questions and answers are personal data: files are created 0600.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
# AF_NETLINK is required: glibc's getaddrinfo() enumerates local interfaces over
# netlink, and without it DNS for api.deepseek.com fails.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Return EPERM for a syscall outside the filter instead of killing node with
# SIGSYS ("code=killed, signal=SYS"), so libuv can take its fallback path.
SystemCallErrorNumber=EPERM
# The code, including node_modules, is read-only; only StateDirectory is writable.
ReadOnlyPaths=/opt/deepseek-app-day9

# Deliberately NOT set: MemoryDenyWriteExecute=true — V8's JIT needs W+X memory
# and node will not start with it.

[Install]
WantedBy=multi-user.target
