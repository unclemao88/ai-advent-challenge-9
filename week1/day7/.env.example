# Copy to .env and fill in the key. .env is git-ignored; this file is not.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=3000

# Optional overrides
# HOST=127.0.0.1
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_TIMEOUT_MS=60000
# How many past messages to replay as context. 0 (the default) means "all".
# DEEPSEEK_HISTORY_LIMIT=0
