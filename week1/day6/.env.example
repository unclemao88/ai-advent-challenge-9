# Copy to .env and fill in. .env is git-ignored — never commit real keys.
#
#   cp .env.example .env

# Required when AGENT_PROVIDER=deepseek. Read on the server only; the browser
# never sees it. Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# Which Agent implementation to use: deepseek (default) or echo.
# "echo" needs no key and replies with the question — handy for UI work.
AGENT_PROVIDER=deepseek

# Optional. deepseek-chat (default) or deepseek-reasoner.
# DEEPSEEK_MODEL=deepseek-chat

# Optional. Override for a gateway or a compatible endpoint.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Optional. How long the agent waits for an answer, in ms (default 60000).
# AGENT_TIMEOUT_MS=60000

# Optional. Prepended as a system message on every question.
# AGENT_SYSTEM_PROMPT=You are a concise assistant.

# Optional server bindings.
# HOST=127.0.0.1
# PORT=3000
